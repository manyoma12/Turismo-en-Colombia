/* =========================================
   EXPLORA COLOMBIA 🇨🇴
   DISEÑO PRINCIPAL
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f4f7f9;
    color: #172733;
}


/* =========================================
   BARRA DE NAVEGACIÓN
========================================= */

.navbar {
    width: 100%;
    min-height: 75px;
    padding: 15px 6%;
    background: #071c2c;
    color: white;

    display: flex;
    align-items: center;
    justify-content: space-between;

    position: sticky;
    top: 0;
    z-index: 1000;

    box-shadow: 0 5px 20px rgba(0,0,0,0.25);
}

.logo {
    font-size: 23px;
    font-weight: bold;
}

.navbar nav {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.navbar nav button {
    border: none;
    background: transparent;
    color: #dce8ee;

    padding: 10px 14px;
    border-radius: 20px;

    cursor: pointer;
    font-weight: bold;

    transition: 0.2s;
}

.navbar nav button:hover {
    background: rgba(255,255,255,0.15);
    color: white;
}


/* =========================================
   PÁGINAS
========================================= */

.pagina {
    display: none;
    min-height: calc(100vh - 75px);
    padding: 60px 6%;
}

.pagina.activa {
    display: block;
}


/* =========================================
   INICIO
========================================= */

.hero {
    min-height: calc(100vh - 75px);

    margin: -60px -6% 0;

    display: flex;
    align-items: center;

    background:
        linear-gradient(
            90deg,
            rgba(3,18,29,0.90),
            rgba(3,18,29,0.35)
        ),
        url("https://images.unsplash.com/photo-1531057242626-ef7d6f2a4c7f?auto=format&fit=crop&w=2000&q=85");

    background-size: cover;
    background-position: center;
}

.hero-contenido {
    width: 90%;
    max-width: 750px;
    margin-left: 8%;
    color: white;
}

.etiqueta {
    display: inline-block;

    color: #f4c95d;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 3px;

    margin-bottom: 15px;
}

.hero h1 {
    font-size: clamp(50px, 8vw, 90px);
    line-height: 0.95;

    margin-bottom: 25px;
}

.hero h1 span {
    color: #f4c95d;
}

.hero p {
    max-width: 650px;

    font-size: 20px;
    line-height: 1.6;

    color: #eef5f8;

    margin-bottom: 30px;
}


/* =========================================
   BOTONES
========================================= */

.boton-principal {
    border: none;

    background: #f4c95d;
    color: #172733;

    padding: 16px 26px;

    border-radius: 30px;

    font-size: 16px;
    font-weight: bold;

    cursor: pointer;

    box-shadow: 0 10px 30px rgba(0,0,0,0.3);

    transition: 0.25s;
}

.boton-principal:hover {
    transform: translateY(-3px);
    background: #ffd970;
}

.boton-volver {
    border: none;

    background: #071c2c;
    color: white;

    padding: 12px 18px;

    border-radius: 10px;

    font-weight: bold;

    cursor: pointer;

    margin-bottom: 25px;
}

.boton-volver:hover {
    background: #0d3852;
}


/* =========================================
   ENCABEZADOS
========================================= */

.encabezado {
    margin-bottom: 35px;
}

.encabezado > span {
    color: #b68b18;

    font-size: 12px;
    font-weight: bold;

    letter-spacing: 3px;
}

.encabezado h2 {
    font-size: clamp(32px, 5vw, 50px);

    margin: 8px 0 10px;
}

.encabezado p {
    color: #667681;

    max-width: 750px;

    font-size: 16px;
    line-height: 1.6;
}


/* =========================================
   CATÁLOGOS
========================================= */

.catalogo {
    display: grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(270px, 1fr)
        );

    gap: 25px;
}


/* =========================================
   TARJETAS
========================================= */

.tarjeta {
    background: white;

    border-radius: 20px;

    overflow: hidden;

    border: 1px solid #e2e9ed;

    box-shadow:
        0 8px 25px rgba(20,45,60,0.08);

    transition: 0.25s;
}

.tarjeta:hover {
    transform: translateY(-7px);

    box-shadow:
        0 15px 35px rgba(20,45,60,0.16);
}

.tarjeta-imagen {
    width: 100%;
    height: 200px;

    object-fit: cover;

    display: block;
}

.tarjeta-contenido {
    padding: 20px;
}

.tarjeta h3 {
    font-size: 22px;

    margin-bottom: 8px;
}

.ubicacion {
    color: #6b7c85;

    font-size: 14px;

    margin-bottom: 10px;
}


/* =========================================
   ESTRELLAS
========================================= */

.estrellas {
    color: #f2b90b;

    font-size: 18px;

    letter-spacing: 2px;
}

.puntuacion {
    color: #334953;

    font-weight: bold;

    margin-left: 7px;
}


/* =========================================
   ETIQUETAS
========================================= */

.etiquetas {
    display: flex;

    gap: 7px;

    flex-wrap: wrap;

    margin: 15px 0;
}

.etiqueta-card {
    background: #eef5f7;

    color: #36515e;

    padding: 7px 10px;

    border-radius: 9px;

    font-size: 12px;

    font-weight: bold;
}


/* =========================================
   PRECIOS
========================================= */

.precio {
    color: #071c2c;

    font-size: 20px;

    font-weight: bold;

    margin: 15px 0;
}

.precio small {
    color: #75848b;

    font-size: 12px;

    font-weight: normal;
}


/* =========================================
   BOTÓN DE TARJETA
========================================= */

.boton-tarjeta {
    width: 100%;

    border: none;

    background: #071c2c;
    color: white;

    padding: 13px;

    border-radius: 11px;

    font-weight: bold;

    cursor: pointer;

    transition: 0.2s;
}

.boton-tarjeta:hover {
    background: #0d3852;
}


/* =========================================
   DETALLES
========================================= */

#contenido-detalles {
    max-width: 900px;

    margin: auto;

    background: white;

    padding: 30px;

    border-radius: 22px;

    box-shadow:
        0 10px 35px rgba(20,45,60,0.10);
}

.detalle-imagen {
    width: 100%;

    max-height: 420px;

    object-fit: cover;

    border-radius: 16px;

    margin-bottom: 25px;
}

#contenido-detalles h2 {
    font-size: 38px;

    margin-bottom: 10px;
}

.detalle-informacion {
    margin-top: 25px;
}

.detalle-fila {
    display: flex;

    justify-content: space-between;

    gap: 20px;

    padding: 14px 0;

    border-bottom: 1px solid #e5ecef;
}

.detalle-fila strong {
    color: #172733;
}

.detalle-fila span {
    color: #667681;

    text-align: right;
}


/* =========================================
   AVISO DE PRECIOS
========================================= */

.aviso {
    background: #fff8df;

    border: 1px solid #efdc96;

    color: #65521a;

    padding: 16px;

    border-radius: 12px;

    margin-top: 25px;

    line-height: 1.5;

    font-size: 14px;
}


/* =========================================
   PIE DE PÁGINA
========================================= */

footer {
    background: #071c2c;

    color: white;

    padding: 35px 6%;

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;

    flex-wrap: wrap;
}

footer strong {
    font-size: 20px;
}

footer p {
    color: #a9bac3;
}


/* =========================================
   RESPONSIVE — CELULAR
========================================= */

@media (max-width: 800px) {

    .navbar {
        flex-direction: column;

        align-items: flex-start;

        gap: 12px;
    }

    .navbar nav {
        width: 100%;

        justify-content: flex-start;
    }

    .navbar nav button {
        font-size: 13px;

        padding: 8px 10px;
    }

    .pagina {
        padding: 45px 5%;
    }

    .hero {
        margin: -45px -5% 0;
    }

    .hero-contenido {
        margin-left: 6%;
    }

    .hero h1 {
        font-size: 55px;
    }

    .hero p {
        font-size: 17px;
    }

    .catalogo {
        grid-template-columns: 1fr;
    }

    #contenido-detalles {
        padding: 20px;
    }

    #contenido-detalles h2 {
        font-size: 30px;
    }

    .detalle-fila {
        flex-direction: column;
        gap: 5px;
    }

    .detalle-fila span {
        text-align: left;
    }

    footer {
        flex-direction: column;

        align-items: flex-start;
    }
}
